{
  "name": "nutrk-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Casca Capacitor (iOS + Android) do nūtrk",
  "engines": { "node": ">=22" },
  "scripts": {
    "sync": "cap sync",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "assets": "capacitor-assets generate --ios --android --iconBackgroundColor '#ffffff' --splashBackgroundColor '#ffffff' --splashBackgroundColorDark '#1b1c1d'",
    "dev:ios": "CAP_SERVER_URL=${CAP_SERVER_URL:-http://localhost:3000} cap sync ios && cap run ios",
    "dev:android": "CAP_SERVER_URL=${CAP_SERVER_URL:-http://10.0.2.2:3000} cap sync android && cap run android"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "typescript": "^7.0.2"
  }
}
